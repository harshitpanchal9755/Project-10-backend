	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="project-10"/>

	<queryString language="SQL">
		<![CDATA[
select id, roll_no, student_id, name, physics, chemistry, maths,
(physics + chemistry + maths) as total
from st_marksheet
where physics > 33 and chemistry > 33 and maths > 33
order by total desc
		]]>
	</queryString>


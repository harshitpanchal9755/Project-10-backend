```groovy
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {

        // 1. Clean Workspace
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        // 2. Clone Backend Repo
        stage('Clone Backend Repo') {
            steps {
                dir('backend') {
                    git branch: 'main',
                        url: 'https://github.com/harshitpanchal9755/Project-10-backend.git'
                }
            }
        }

        // 3. Clone Frontend Repo
        stage('Clone Frontend Repo') {
            steps {
                dir('frontend') {
                    git branch: 'main',
                        url: 'https://github.com/harshitpanchal9755/Project-10-frontend.git'
                }
            }
        }

        // 4. Angular Build
        stage('Angular Build') {
            steps {
                dir('frontend') {
                    bat '''
                        node --version
                        npm --version

                        call npm install --legacy-peer-deps
                        if errorlevel 1 exit /b 1

                        call npm run build -- --output-path=dist/app
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        // 5. Spring Boot Build
        stage('Spring Boot Build') {
            steps {
                dir('backend\\ORSProject-10-JWT') {
                    bat '''
                        mvn -version
                        call mvn clean package -DskipTests
                        if errorlevel 1 exit /b 1
                    '''
                }
            }
        }

        // 6. Verify Angular Build
        stage('Verify Angular Build') {
            steps {
                bat '''
                    if not exist "frontend\\dist\\app\\index.html" (
                        echo Angular build NOT FOUND
                        exit /b 1
                    )
                    echo Angular build verified
                '''
            }
        }

        // 7. Verify Spring Boot Build
        stage('Build Spring Boot') {
            steps {
                bat '''
                    if not exist "backend\\ORSProject-10-JWT\\target\\ORSProject-10-JWT-0.0.1-SNAPSHOT.jar" (
                        echo Spring Boot JAR NOT FOUND
                        exit /b 1
                    )
                    echo Spring Boot build verified
                '''
            }
        }

        // 8. Prepare Backend JAR
        stage('Prepare Backend Jar') {
            steps {
                bat '''
                    copy /Y "backend\\ORSProject-10-JWT\\target\\ORSProject-10-JWT-0.0.1-SNAPSHOT.jar" "backend\\ORSProject-10-JWT-0.0.1-SNAPSHOT.jar"
                    if errorlevel 1 exit /b 1
                '''
            }
        }

        // 9. Create Docker Compose
        stage('Create Docker Compose') {
            steps {
                bat '''
                    (
                    echo services:
                    echo   frontend:
                    echo     container_name: frontend-container
                    echo     build:
                    echo       context: ./frontend
                    echo       dockerfile: Dockerfile
                    echo     ports:
                    echo       - "4200:80"
                    echo     depends_on:
                    echo       - backend
                    echo     restart: unless-stopped
                    echo.
                    echo   backend:
                    echo     container_name: backend-container
                    echo     build:
                    echo       context: ./backend
                    echo       dockerfile: Dockerfile
                    echo     ports:
                    echo       - "8080:8080"
                    echo     depends_on:
                    echo       - mysql
                    echo     restart: unless-stopped
                    echo.
                    echo   mysql:
                    echo     container_name: mysql-container
                    echo     image: mysql:8.0
                    echo     environment:
                    echo       MYSQL_ROOT_PASSWORD: root
                    echo       MYSQL_DATABASE: ors_p10
                    echo     ports:
                    echo       - "3307:3306"
                    echo     volumes:
                    echo       - mysql_data:/var/lib/mysql
                    echo     restart: unless-stopped
                    echo.
                    echo volumes:
                    echo   mysql_data:
                    ) > docker-compose.yml
                '''
            }
        }

        // 10. Create Backend Dockerfile
        stage('Create Backend Dockerfile') {
            steps {
                bat '''
                    (
                    echo FROM eclipse-temurin:11-jdk
                    echo.
                    echo WORKDIR /app
                    echo.
                    echo COPY ORSProject-10-JWT-0.0.1-SNAPSHOT.jar app.jar
                    echo.
                    echo EXPOSE 8080
                    echo.
                    echo CMD ["java", "-jar", "app.jar"]
                    ) > backend\\Dockerfile
                '''
            }
        }

        // 11. Create Frontend Dockerfile
        stage('Create Frontend Dockerfile') {
            steps {
                bat '''
                    (
                    echo FROM nginx:alpine
                    echo.
                    echo COPY dist/app/ /usr/share/nginx/html/
                    echo.
                    echo EXPOSE 80
                    echo.
                    echo CMD ["nginx", "-g", "daemon off;"]
                    ) > frontend\\Dockerfile
                '''
            }
        }

        // 12. Verify Docker Files
        stage('Verify Docker Files') {
            steps {
                bat '''
                    if not exist docker-compose.yml exit /b 1
                    if not exist backend\\Dockerfile exit /b 1
                    if not exist frontend\\Dockerfile exit /b 1
                    if not exist frontend\\dist\\app\\index.html exit /b 1
                    if not exist backend\\ORSProject-10-JWT-0.0.1-SNAPSHOT.jar exit /b 1

                    echo ALL DOCKER FILES VERIFIED
                '''
            }
        }

        // 13. Remove Old Containers
        stage('Remove Old Containers') {
            steps {
                bat '''
                    docker rm -f frontend-container 2>nul
                    docker rm -f backend-container 2>nul
                    docker rm -f mysql-container 2>nul

                    echo OLD CONTAINERS REMOVED
                '''
            }
        }

        // 14. Remove Old Docker Images
        stage('Remove Old Docker Images') {
            steps {
                bat '''
                    docker image rm -f project-10-frontend project-10-backend 2>nul

                    echo OLD APPLICATION IMAGES CLEANED
                '''
            }
        }

        // 15. Build Docker Images
        stage('Build Docker Images') {
            steps {
                bat '''
                    docker compose build
                    if errorlevel 1 exit /b 1

                    echo DOCKER IMAGES BUILT
                '''
            }
        }

        // 16. Run Containers
        stage('Run Containers') {
            steps {
                bat '''
                    docker compose up -d
                    if errorlevel 1 exit /b 1

                    echo CONTAINERS STARTED
                '''
            }
        }

        // 17. Check Containers
        stage('Check Containers') {
            steps {
                bat '''
                    echo ======================================
                    echo DOCKER CONTAINER STATUS
                    echo ======================================

                    docker compose ps

                    echo.
                    docker ps --filter "name=frontend-container"
                    docker ps --filter "name=backend-container"
                    docker ps --filter "name=mysql-container"

                    echo.
                    echo ======================================
                    echo DEPLOYMENT CHECK COMPLETE
                    echo ======================================
                '''
            }
        }
    }

    post {
        success {
            echo 'PIPELINE SUCCESS'
            echo 'Frontend: http://localhost:4200'
            echo 'Backend:  http://localhost:8080'
        }

        failure {
            echo 'PIPELINE FAILED - Check Jenkins Console Output'
        }
    }
}
